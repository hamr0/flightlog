{
  "name": "flightlog",
  "version": "0.6.1",
  "description": "A flight recorder for your app — zero-dependency local error capture to JSONL.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc",
    "prepublishOnly": "npm run build:types",
    "test": "node --test"
  },
  "files": [
    "src/",
    "types/",
    "README.md",
    "flightlog.context.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "error",
    "errors",
    "logging",
    "jsonl",
    "uncaughtexception",
    "unhandledrejection",
    "zero-dependency",
    "error-handler",
    "error-tracking"
  ],
  "author": "Amr <avoidaccess@msn.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hamr0/flightlog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/flightlog.git"
  },
  "bugs": {
    "url": "https://github.com/hamr0/flightlog/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
